zebra_sources = [
  yang_embed.process('../yang/frr-zebra.yang'),
  yang_embed.process('../yang/frr-zebra-route-map.yang'),

  'debug_nl.c',

  'connected.c',
  clippy.process('debug.c'),
  'if_ioctl.c',
  'if_netlink.c',
  'if_socket.c',
  'if_sysctl.c',
  clippy.process('interface.c'),
  'ioctl.c',
  'ipforward_proc.c',
  'ipforward_sysctl.c',
  'kernel_netlink.c',
  'kernel_socket.c',
  clippy.process('label_manager.c'),
  'main.c',
  'netconf_netlink.c',
  'redistribute.c',
  'router-id.c',
  'rt_netlink.c',
  'ge_netlink.c',
  'rt_socket.c',
  clippy.process('rtadv.c'),
  'rtread_netlink.c',
  'rtread_sysctl.c',
  'rule_netlink.c',
  'rule_socket.c',
  'table_manager.c',
  'tc_netlink.c',
  'tc_socket.c',
  'zapi_msg.c',
  'zebra_affinitymap.c',
  'zebra_dplane.c',
  'zebra_errors.c',
  'zebra_gr.c',
  'zebra_l2.c',
  'zebra_l2_bridge_if.c',
  'zebra_evpn.c',
  'zebra_evpn_mac.c',
  'zebra_evpn_neigh.c',
  'zebra_mlag.c',
  clippy.process('zebra_mlag_vty.c'),
  'zebra_mpls.c',
  'zebra_mpls_netlink.c',
  'zebra_mpls_openbsd.c',
  'zebra_mpls_null.c',
  'zebra_mpls_vty.c',
  'zebra_srv6.c',
  clippy.process('zebra_srv6_vty.c'),
  'zebra_mroute.c',
  'zebra_nb.c',
  'zebra_nb_config.c',
  'zebra_nb_rpcs.c',
  'zebra_nb_state.c',
  'zebra_netns_id.c',
  'zebra_netns_notify.c',
  'zebra_nhg.c',
  'zebra_ns.c',
  'zebra_opaque.c',
  'zebra_pbr.c',
  'zebra_ptm.c',
  'zebra_ptm_redistribute.c',
  'zebra_pw.c',
  'zebra_rib.c',
  'zebra_router.c',
  'zebra_rnh.c',
  clippy.process('zebra_routemap.c'),
  'zebra_routemap_nb.c',
  'zebra_routemap_nb_config.c',
  'zebra_script.c',
  'zebra_srte.c',
  'zebra_tc.c',
  'zebra_trace.c',
  clippy.process('zebra_vrf.c'),
  clippy.process('zebra_vty.c'),
  'zebra_vxlan.c',
  'zebra_vxlan_if.c',
  'zebra_evpn_mh.c',
  'zebra_neigh.c',
  clippy.process('zserv.c'),
]

zebra_bin = executable('zebra',
  sources : zebra_sources, 
  c_args : ['-DHAVE_CONFIG_H'],
  include_directories : include_directories('..', '../lib', '../include'),
  link_with: [
    libfrr,
  ],
  dependencies : [
    libyang,
    libjson,
  ],
)

zebra_bin_wrap = custom_target('zebra_bin_wrap',
  output: ['zebra.dep'],
  input: [zebra_bin],
  command: ['ln', '-sf', '@PLAINNAME@', '@OUTPUT@'],
)
zebra_xref = xrelfo.process(zebra_bin_wrap)

